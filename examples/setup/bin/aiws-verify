#!/bin/sh
# ~/.aiws/bin/aiws-verify <profile> <name> [allowed-url]: check a guest against SETUP.md §15.
# Run it as `aiws verify`, which selects the guest's VM.
# The container's shape is checked from the host with docker inspect. The rest runs inside the
# guest, from a script piped to its shell: the host only reads what it prints. allowed-url is a
# URL the guest's allow-list should let through; without it, that check is skipped.
# Exits 1 if any check fails. The checklist's manual items (file sharing, the proxy's log, a dev
# server on the forwarded port, git push being refused) stay manual.
set -u                             # not -e: a failing check is reported, not fatal
[ $# -ge 2 ] || { echo "usage: aiws-verify <profile> <name> [allowed-url]" >&2; exit 64; }
profile=$1; name=$2; allowed=${3:-}
guest="aiws-$profile-$name"
fails=0
host_address=192.168.5.2           # the host, as containers in colima's VMs reach it
docker inspect "$guest" >/dev/null 2>&1 || { echo "aiws-verify: no container $guest" >&2; exit 1; }

result() { if [ "$1" -eq 0 ]; then echo "ok    $2"; else echo "FAIL  $2"; fails=$((fails + 1)); fi; }
inspect() { docker inspect -f "$1" "$guest"; }

# The container's shape (SETUP.md §2, §4).
[ "$(inspect '{{.HostConfig.Privileged}}')" = false ]; result $? "not privileged"
inspect '{{json .HostConfig.CapDrop}}' | grep -q '"ALL"'; result $? "all capabilities dropped"
inspect '{{json .HostConfig.SecurityOpt}}' | grep -q 'no-new-privileges:true'; result $? "no-new-privileges"
[ "$(inspect '{{.HostConfig.PidMode}}')" != host ]; result $? "own PID namespace"
! inspect '{{range .Mounts}}{{.Source}} {{end}}' | grep -q 'docker.sock'; result $? "no runtime socket mounted"
mounts=$(inspect '{{range .Mounts}}{{.Destination}} {{end}}')
expected="/home/aiws /home/aiws/exchange"
case $profile in trusted|public) expected="$expected /home/aiws/.dotfiles" ;; esac
[ "$(echo "$mounts" | tr ' ' '\n' | grep . | sort | tr '\n' ' ')" = \
  "$(echo "$expected" | tr ' ' '\n' | sort | tr '\n' ' ')" ]; result $? "mounts are exactly: $expected"
networks=$(inspect '{{range $k, $v := .NetworkSettings.Networks}}{{$k}} {{end}}')
case $profile in
  hostile-sample) [ "$networks" = "none " ]; result $? "no network" ;;
  *) [ "$networks" = "$guest " ]; result $? "only on its internal network ($guest)" ;;
esac
case $profile in
  trusted|public)
    [ "$(inspect '{{range .Mounts}}{{if eq .Destination "/home/aiws/.dotfiles"}}{{.RW}}{{end}}{{end}}')" = false ]
    result $? "dotfiles mounted read-only" ;;
esac

# Everything else, from inside the guest.
others=$(docker ps -a --format '{{.Names}}' | grep '^aiws-' | grep -v "^$guest" | tr '\n' ' ' || true)
guest_checks() { cat <<'EOF'
result() { if [ "$1" -eq 0 ]; then echo "ok    $2"; else echo "FAIL  $2"; fi; }
quietly() { "$@" >/dev/null 2>&1; }
# The proxy's answer, not just a failure: a network that blocks the host would also fail.
connect_code() { curl -s -m 10 -o /dev/null -w '%{http_connect}' "$1"; }  # HTTPS, through CONNECT
http_code() { curl -s -m 10 -o /dev/null -w '%{http_code}' "$1"; }

if [ "$PROFILE" = hostile-sample ]; then
  [ "$(wc -l < /proc/net/route)" -le 1 ]; result $? "no routes"
  ! quietly curl -fsS -m 5 https://1.1.1.1; result $? "no connection to the internet"
  exit 0
fi

case $PROFILE in
  trusted|public)
    [ -n "$(ls -A ~/.dotfiles)" ]; result $? "dotfiles present (an empty mount means the VM lacks it)"
    ! quietly touch ~/.dotfiles/.aiws-verify; result $? "dotfiles not writable"
    [ -z "$(find / \( -path /proc -o -path /sys \) -prune -o -type s -print 2>/dev/null \
      | grep -v '/\.priviledge/relay\.sock$')" ]; result $? "no Unix sockets besides the relay's"
    [ "$(connect_code https://example.com)" = 403 ]; result $? "the proxy refuses a host off the allow-list"
    if [ -n "$ALLOWED" ]; then
      quietly curl -fsS -m 15 -o /dev/null "$ALLOWED"; result $? "an allow-listed host works ($ALLOWED)"
    fi ;;
  hostile-web)
    quietly curl -fsS -m 15 -o /dev/null https://example.org; result $? "the public internet works" ;;
esac
! quietly getent hosts example.com; result $? "external names don't resolve in the guest"
[ "$(http_code "http://$HOST_ADDRESS")" = 403 ]; result $? "the proxy refuses the host ($HOST_ADDRESS)"
[ "$(http_code http://10.0.0.1)" = 403 ]; result $? "the proxy refuses a private address"
! quietly curl -fsS -m 5 --noproxy '*' "http://$HOST_ADDRESS"; result $? "no route to the host around the proxy"
! quietly curl -fsS -m 5 --noproxy '*' https://1.1.1.1; result $? "no route out around the proxy"
for o in $OTHERS; do
  ! quietly getent hosts "$o"; result $? "another guest's container doesn't resolve ($o)"
done
EOF
}
out=$(guest_checks | docker exec -i -e PROFILE="$profile" -e ALLOWED="$allowed" -e OTHERS="$others" \
  -e HOST_ADDRESS="$host_address" "$guest" sh -s)
echo "$out"
fails=$((fails + $(echo "$out" | grep -c '^FAIL' || true)))
[ "$fails" -eq 0 ] || { echo "$fails check(s) failed" >&2; exit 1; }
