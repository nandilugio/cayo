#!/bin/sh
# cayo-window <profile> <name>: a tmux window for a guest: the editor, the agent and a shell, each
# in the guest. The agent's command is CAYO_AGENT (default opencode), settable in ~/.cayo/config.
set -eu
p=$1; n=$2
CAYO_AGENT=opencode
[ ! -f "$HOME/.cayo/config" ] || . "$HOME/.cayo/config"
tmux new-window -n "$p/$n" "cayo exec $p $n nvim"
tmux split-window -h "cayo exec $p $n $CAYO_AGENT"
tmux split-window -v "cayo exec $p $n"
