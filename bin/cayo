#!/bin/sh
# cayo: isolated environments for AI agents and other untrusted work (README.md).
#   cayo new    <profile> <name>                create the guest cayo-<profile>-<name>
#   cayo rm     <profile> <name>                remove it, with its network, sidecars and home volume
#   cayo recreate <profile> <name>              recreate it from the current images, keeping its
#                                               home volume and forwarded ports
#   cayo exec   <profile> <name> [cmd...]       run a command in it (default: a login shell)
#   cayo port   <profile> <name> <port>[:<guest-port>]
#                                               forward 127.0.0.1:<port> on the host to the guest
#   cayo reload <profile> <name>                reload its proxy, after editing its allow-list
#   cayo denied <profile> <name>                the hosts its proxy refused, most frequent first
#   cayo allow  <profile> <name> <host>...      add hosts to its allow-list, and reload
#   cayo verify <profile> <name> [allowed-url]  check it against README.md's checklist
#   cayo build                                  rebuild the guest image in each running VM, with
#                                               updated base and sidecar images
#   cayo vm start|stop|delete <vm>              create or start a VM (cayo, cayo-hostile) with its
#                                               mounts; stop it; delete it with all its data
# Profiles are trust levels: trusted, public, hostile-web, hostile-sample (README.md). Each one is
# a container shape: which VM it runs in, what is mounted, and how it reaches the network.
set -eu

usage() { sed -n '3,17p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 64; }
die() { echo "cayo: $*" >&2; exit 1; }
vms="cayo cayo-hostile"

# The checkout holds the tool (this script, cayo-verify, the base Dockerfile, the proxies'
# configuration); ~/.cayo holds the user's files: config, guest-init, image/, egress/ allow-lists.
bin=$(dirname "$(readlink -f "$0")")
root=$(cd "$bin/.." && pwd)
user_dir="$HOME/.cayo"

# Settings, overridable in ~/.cayo/config, a shell file of these variables (README.md).
CAYO_DOTFILES="$user_dir/dotfiles"          # mounted read-only into trusted and public guests
CAYO_DOTFILES_MOUNT=/home/cayo/.dotfiles    # where guests see it
CAYO_VM_MOUNTS=                             # more host paths for the cayo VM, read-only
CAYO_NO_PROXY=${CAYO_NO_PROXY:-}            # hosts a new guest reaches directly (its dev services)
[ ! -f "$user_dir/config" ] || . "$user_dir/config"

# ---- VMs and images ------------------------------------------------------------------------

# The dotfiles' real path, which is what the VM mounts and guests bind, or nothing.
dotfiles_path() { (cd "$CAYO_DOTFILES" 2>/dev/null && pwd -P) || true; }

# The image a guest of a profile runs: the most specific of the user's layers that exists
# (~/.cayo/image/<profile>/Dockerfile, then ~/.cayo/image/Dockerfile), else the base.
guest_image() {
  if [ -f "$user_dir/image/$1/Dockerfile" ]; then echo "cayo-$1"
  elif [ -f "$user_dir/image/Dockerfile" ]; then echo cayo-local
  else echo cayo-base; fi
}

# The VMs. This is their one definition: what each mounts from the host, read-only unless marked
# :w, and nothing else. The proxies' configuration is copied into them (start_proxy), so no VM
# mounts it.
vm_start() {
  vm=$1; exchange_root="$HOME/cayo-exchange/$vm"
  case $vm in
    cayo)
      set -- --cpus 4 --memory 8 --mount "$exchange_root:w"
      dotfiles=$(dotfiles_path); [ -z "$dotfiles" ] || set -- "$@" --mount "$dotfiles"
      for path in $CAYO_VM_MOUNTS; do set -- "$@" --mount "$path"; done ;;
    cayo-hostile)
      set -- --cpus 2 --memory 2 --mount "$exchange_root:w" ;;
  esac
  if docker --context "colima-$vm" info >/dev/null 2>&1; then
    echo "cayo: $vm is running; to change its mounts: cayo vm stop $vm, then start it again"
  else
    mkdir -p "$exchange_root"
    # --activate=false: the machine's default Docker context stays what it was.
    colima start --profile "$vm" --activate=false "$@"
  fi
  docker --context "colima-$vm" image inspect cayo-base >/dev/null 2>&1 || build_images "$vm"
}

# The guest images, on a freshly pulled base: the base, the user's layers if any, and the
# sidecars' images; then drop the images the rebuild left unused. Guests keep the images they were
# created from until `cayo recreate`. The base needs no build context: its Dockerfile is sent alone.
build_images() {
  echo "cayo: building the guest images in $1"
  docker --context "colima-$1" build --pull -t cayo-base - < "$root/Dockerfile"
  [ ! -f "$user_dir/image/Dockerfile" ] || docker --context "colima-$1" build -t cayo-local "$user_dir/image"
  for p in trusted public hostile-web hostile-sample; do
    [ ! -f "$user_dir/image/$p/Dockerfile" ] || docker --context "colima-$1" build -t "cayo-$p" "$user_dir/image/$p"
  done
  for image in ubuntu/squid alpine/socat; do docker --context "colima-$1" pull -q "$image" >/dev/null; done
  docker --context "colima-$1" image prune -f >/dev/null
}

vm_command() {
  [ $# -eq 2 ] || usage
  case " $vms " in *" $2 "*) ;; *) die "unknown VM $2 (VMs: $vms)" ;; esac  # never another colima VM
  case $1 in
    start)  vm_start "$2" ;;
    stop)   colima stop --profile "$2" ;;
    # --data: otherwise the VM's Docker data (images, guests' home volumes) stays on disk, and a
    # VM created later with the same name gets it back.
    delete) colima delete --data --profile "$2" ;;
    *)      usage ;;
  esac
}

build_command() {
  built=
  for vm in $vms; do
    docker --context "colima-$vm" info >/dev/null 2>&1 || continue
    build_images "$vm"; built=1
  done
  [ -n "$built" ] || die "no VM is running; start one with: cayo vm start cayo"
}

# ---- Guests ----------------------------------------------------------------------------------

# The guest a command works on, from its profile and name; the VM it runs in (hostile guests never
# share one with the others), selected for every docker command that follows.
guest_context() {
  profile=$1; name=$2
  # Letters, digits, dots and underscores, as Docker accepts in a name, minus '-': cayo names a
  # guest's network, volume and sidecars by appending to the container's name.
  printf '%s\n' "$name" | grep -Eqx '[A-Za-z0-9][A-Za-z0-9_.]*' \
    || die "guest names are letters, digits, '.' and '_', and don't start with '.' or '_': $name"
  guest="cayo-$profile-$name"        # the container; also the prefix of its network and sidecars
  home_volume="$guest-home"
  case $profile in
    trusted|public)             vm=cayo;         egress=allowlist ;;
    hostile-web)                vm=cayo-hostile; egress=public ;;
    hostile-sample)             vm=cayo-hostile; egress=none ;;
    *) die "unknown profile $profile (profiles: trusted, public, hostile-web, hostile-sample)" ;;
  esac
  export DOCKER_CONTEXT="colima-$vm"
  docker info >/dev/null 2>&1 || die "VM $vm isn't running; start it with: cayo vm start $vm"
  exchange_dir="$HOME/cayo-exchange/$vm/$guest"
  allow_list="$user_dir/egress/$guest.txt"
}

# Whether this guest gets the dotfiles: trusted and public guests, when there are any.
guest_dotfiles() {
  case $profile in trusted|public) dotfiles_path ;; esac
}

# The egress proxy: on the guest's internal network and on the bridge, the guest's only way out.
# Its configuration and allow-list are copied in from the host (docker cp, which reads them on the
# host, links resolved), so no VM mounts them, and edits take `cayo reload`.
copy_proxy_config() {
  docker cp -L "$root/egress/squid-$egress.conf" "$guest-proxy:/etc/squid/squid.conf"
  [ "$egress" != allowlist ] || docker cp -L "$allow_list" "$guest-proxy:/etc/squid/allow.txt"
}

start_proxy() {
  if [ "$egress" = allowlist ] && [ ! -f "$allow_list" ]; then
    # A new list starts as a copy of ~/.cayo/egress/default.txt, the user's hosts for every new
    # guest, or else of the commented template, empty: the proxy refuses everything until
    # `cayo allow` adds hosts.
    mkdir -p "$user_dir/egress"
    if [ -f "$user_dir/egress/default.txt" ]; then
      cp "$user_dir/egress/default.txt" "$allow_list"
      echo "cayo: created $allow_list from egress/default.txt"
    else
      cp "$root/examples/allow-list.txt" "$allow_list"
      echo "cayo: created $allow_list, empty: add hosts with cayo allow $profile $name <host>..."
    fi
  fi
  docker create --name "$guest-proxy" --network bridge ubuntu/squid >/dev/null
  copy_proxy_config
  docker start "$guest-proxy" >/dev/null
  docker network connect --alias "$guest-proxy" "$guest" "$guest-proxy"
  # Squid takes a moment to listen, and the guest's first requests (guest-init's) must not race it.
  tries=0
  until docker exec "$guest-proxy" bash -c 'exec 3<>/dev/tcp/127.0.0.1/3128' 2>/dev/null; do
    tries=$((tries + 1)); [ "$tries" -lt 50 ] || die "$guest-proxy didn't start listening"
    sleep 0.2
  done
}

reload_proxy() {
  [ "$egress" != none ] || die "$guest has no network, so no proxy"
  copy_proxy_config
  out=$(docker exec "$guest-proxy" squid -k reconfigure 2>&1) || { echo "$out" >&2; die "reload failed"; }
}

# The hosts the proxy refused, from its log: CONNECT host:port, or a plain HTTP URL.
denied_hosts() {
  [ "$egress" != none ] || die "$guest has no network, so no proxy"
  docker exec "$guest-proxy" cat /var/log/squid/access.log \
    | awk '$4 ~ /DENIED/ { print $7 }' | sed -E 's#^[a-z]+://##; s#[:/].*##' \
    | sort | uniq -c | sort -rn
}

allow_hosts() {
  [ "$egress" = allowlist ] || die "$guest has no allow-list (profile $profile)"
  [ $# -gt 0 ] || usage
  for host in "$@"; do
    # A hostname, or .domain for its subdomains too: nothing Squid could read as anything else.
    printf '%s\n' "$host" | grep -Eqx '\.?[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?(\.[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?)+' \
      || die "not a hostname: $host"
  done
  for host in "$@"; do
    grep -qxF "$host" "$allow_list" || printf '%s\n' "$host" >> "$allow_list"
  done
  reload_proxy
}

new_guest() {
  # 1. What the profile decides: the mounts, and the egress mode.
  mounts="-v $home_volume:/home/cayo -v $exchange_dir:/home/cayo/exchange"
  dotfiles=$(guest_dotfiles)
  if [ -n "$dotfiles" ]; then
    mounts="$mounts -v $dotfiles:$CAYO_DOTFILES_MOUNT:ro"
  elif [ "$egress" = allowlist ]; then
    echo "cayo: no dotfiles for $guest: CAYO_DOTFILES ($CAYO_DOTFILES) doesn't exist"
  fi

  # 2. Storage: the home volume and the per-guest exchange directory.
  docker volume create "$home_volume" >/dev/null
  mkdir -p "$exchange_dir"

  # 3. Network: none at all, or an internal network whose only way out is the proxy.
  if [ "$egress" = none ]; then
    network="--network none"
  else
    docker network create --internal "$guest" >/dev/null
    start_proxy
    proxy="http://$guest-proxy:3128"
    no_proxy="localhost,127.0.0.1${CAYO_NO_PROXY:+,$CAYO_NO_PROXY}"
    network="--network $guest \
      -e http_proxy=$proxy -e https_proxy=$proxy -e HTTP_PROXY=$proxy -e HTTPS_PROXY=$proxy \
      -e no_proxy=$no_proxy -e NO_PROXY=$no_proxy"
  fi

  # 4. The guest: no capabilities, no privilege escalation, idle until something execs into it.
  # shellcheck disable=SC2086 # $network and $mounts are lists of options
  docker run -d --name "$guest" --hostname "$guest" --init \
    --cap-drop ALL --security-opt no-new-privileges:true \
    -e TERM=xterm-256color $network $mounts \
    "$(guest_image "$profile")" sleep infinity >/dev/null
}

# ~/.cayo/guest-init, piped into a new guest's shell (the host only sends it), with CAYO_PROFILE,
# CAYO_NAME and every CAYO_INIT_* variable set in the environment or in ~/.cayo/config. Never for
# hostile guests: they get nothing of the user's, those variables included.
guest_init() {
  hook="$user_dir/guest-init"
  [ -f "$hook" ] || return 0
  case $profile in hostile-*) return 0 ;; esac
  set -- -e CAYO_PROFILE="$profile" -e CAYO_NAME="$name"
  for var in $(set | sed -n 's/^\(CAYO_INIT_[A-Za-z0-9_]*\)=.*/\1/p'); do
    export "${var?}"; set -- "$@" -e "$var"
  done
  echo "cayo: running ~/.cayo/guest-init in $guest"
  docker exec -i "$@" "$guest" sh -s < "$hook" || die "$guest is created, but ~/.cayo/guest-init failed"
}

# A forwarder for one port, on the bridge (Docker publishes no ports of a container that is only
# on an internal network) and attached to the guest's network. colima forwards the published port
# to the host's 127.0.0.1.
forward_port() {
  [ -n "${1:-}" ] || usage
  host_port=${1%%:*}; guest_port=${1#*:}
  forwarder="$guest-port-$host_port"
  ! docker inspect "$forwarder" >/dev/null 2>&1 || die "port $host_port is already forwarded"
  docker run -d --name "$forwarder" --network bridge -p "127.0.0.1:$host_port:$guest_port" \
    alpine/socat "TCP-LISTEN:$guest_port,fork,reuseaddr" "TCP:$guest:$guest_port" >/dev/null \
    || { docker rm -f "$forwarder" >/dev/null 2>&1; die "can't forward port $host_port"; }
  docker network connect "$guest" "$forwarder"
}

# The guest's containers and network; its home volume stays.
remove_containers() {
  docker ps -a --format '{{.Names}}' | grep -E "^$guest(-proxy|-port-[0-9]+)?\$" \
    | xargs docker rm -f -v >/dev/null 2>&1 || true  # -v: also the images' anonymous volumes
  docker network rm "$guest" >/dev/null 2>&1 || true
}

# The forwarded ports, as <host-port>:<guest-port>, read from the forwarders themselves.
forwarded_ports() {
  docker ps -a --format '{{.Names}}' | grep -E "^$guest-port-[0-9]+\$" | while read -r forwarder; do
    docker inspect -f '{{range $p, $b := .HostConfig.PortBindings}}{{(index $b 0).HostPort}}:{{$p}}{{end}}' \
      "$forwarder" | sed 's#/tcp$##'
  done
}

recreate_guest() {
  docker inspect "$guest" >/dev/null 2>&1 || die "no guest $guest"
  ports=$(forwarded_ports)
  remove_containers
  new_guest
  for port in $ports; do forward_port "$port"; done
}

# Without a command: a login shell, the one the image records for the user (bash in the base; your
# layer may change it).
enter_guest() {
  [ $# -gt 0 ] || set -- sh -c 'exec "$(getent passwd cayo | cut -d: -f7)" -l'
  exec docker exec -it -w /home/cayo/src "$guest" "$@"
}

verify_guest() {
  dotfiles_mount=; [ -z "$(guest_dotfiles)" ] || dotfiles_mount=$CAYO_DOTFILES_MOUNT
  CAYO_GUEST_DOTFILES=$dotfiles_mount exec "$bin/cayo-verify" "$profile" "$name" "$@"
}

# ---- Dispatch --------------------------------------------------------------------------------

[ $# -ge 1 ] || usage
command=$1; shift
case $command in
  vm)     vm_command "$@" ;;
  build)  build_command ;;
  new|rm|recreate|exec|port|reload|denied|allow|verify)
    [ $# -ge 2 ] || usage
    guest_context "$1" "$2"; shift 2
    case $command in
      new)      new_guest; guest_init ;;
      rm)       remove_containers; docker volume rm "$home_volume" ;;
      recreate) recreate_guest ;;
      exec)     enter_guest "$@" ;;
      port)     forward_port "$@" ;;
      reload)   reload_proxy ;;
      denied)   denied_hosts ;;
      allow)    allow_hosts "$@" ;;
      verify)   verify_guest "$@" ;;
    esac ;;
  *)      usage ;;
esac
